{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "doses_ch.schema.json",
 "title": "Table suisse des doses (doses_ch.json)",
 "description": "Table suisse des doses. Chaque ligne cite mot pour mot la rubrique de l’information professionnelle suisse (AIPS) issue du texte officiel publié par Refdata/Swissmedic (aips_extrait), datée (aips_version, aips_publie, lu_le) ; la ligne de dose dérive uniquement de cet extrait et se contrôle par tools/doses_check.py. Jamais de lecture automatisée du Compendium.",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "substance",
   "produit_ch",
   "dose",
   "voie",
   "population",
   "aips_rubrique",
   "url",
   "lu_le",
   "lu_par",
   "aips_extrait",
   "aips_version",
   "aips_publie",
   "url_texte"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
   },
   "substance": {
    "type": "string",
    "minLength": 1
   },
   "produit_ch": {
    "type": "string",
    "minLength": 1
   },
   "dose": {
    "type": "string",
    "minLength": 1
   },
   "voie": {
    "type": "string",
    "minLength": 1
   },
   "intervalle": {
    "type": "string",
    "minLength": 1
   },
   "duree": {
    "type": "string",
    "minLength": 1
   },
   "population": {
    "type": "string",
    "minLength": 1
   },
   "aips_rubrique": {
    "type": "string",
    "minLength": 1
   },
   "url": {
    "type": "string",
    "pattern": "^https://(www\\.)?(swissmedicinfo\\.ch|swissmedicinfo-pro\\.ch|compendium\\.ch|swissmedic\\.ch)/"
   },
   "lu_le": {
    "type": "string",
    "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
   },
   "lu_par": {
    "enum": [
     "Galien",
     "Vial",
     "Pharmakon"
    ]
   },
   "note": {
    "type": "string",
    "minLength": 1
   },
   "indication": {
    "type": "string",
    "minLength": 1
   },
   "titulaire": {
    "type": "string",
    "minLength": 1
   },
   "aips_version": {
    "type": "string",
    "minLength": 1
   },
   "aips_publie": {
    "type": "string",
    "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
   },
   "url_texte": {
    "type": "string",
    "pattern": "^https://files\\.refdata\\.ch/"
   },
   "methode": {
    "type": "string",
    "minLength": 1
   },
   "aips_extrait": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "rubrique",
      "texte"
     ],
     "properties": {
      "rubrique": {
       "type": "string",
       "minLength": 1
      },
      "texte": {
       "type": "string",
       "minLength": 20
      }
     }
    }
   }
  }
 }
}
