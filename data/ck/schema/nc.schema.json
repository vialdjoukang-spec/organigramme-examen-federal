{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nc.schema.json",
 "title": "Nerfs crâniens (nc.json)",
 "description": "Une entrée par paire : anatomie, sites lésionnels et chaîne lésion → sémiologie → exploration → diagnostic, vues SVG.",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "nom",
   "noyaux",
   "trajet",
   "foramens",
   "territoires",
   "lesions",
   "vues"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^nc(0[1-9]|1[0-2])$"
   },
   "nom": {
    "type": "string",
    "minLength": 1
   },
   "noyaux": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    }
   },
   "trajet": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string",
     "minLength": 1
    }
   },
   "foramens": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    }
   },
   "territoires": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string",
     "minLength": 1
    }
   },
   "lesions": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "site",
      "niveau",
      "deficit",
      "syn",
      "exam_orientant",
      "hyp"
     ],
     "properties": {
      "site": {
       "type": "integer",
       "minimum": 1
      },
      "niveau": {
       "type": "string",
       "minLength": 1
      },
      "deficit": {
       "type": "string",
       "minLength": 1
      },
      "syn": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "exam_orientant": {
       "type": "string",
       "minLength": 1
      },
      "hyp": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
       }
      },
      "src": {
       "$ref": "src.schema.json#/$defs/refs"
      },
      "statut": {
       "$ref": "src.schema.json#/$defs/statut"
      }
     }
    }
   },
   "vues": {
    "type": "object",
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "face": {
      "type": "string",
      "pattern": "^assets/nc/nc(0[1-9]|1[0-2])-[a-z0-9-]+\\.svg$"
     },
     "profil": {
      "type": "string",
      "pattern": "^assets/nc/nc(0[1-9]|1[0-2])-[a-z0-9-]+\\.svg$"
     },
     "trois_quarts": {
      "type": "string",
      "pattern": "^assets/nc/nc(0[1-9]|1[0-2])-[a-z0-9-]+\\.svg$"
     },
     "plan": {
      "type": "string",
      "pattern": "^assets/nc/nc(0[1-9]|1[0-2])-[a-z0-9-]+\\.svg$"
     }
    }
   },
   "tour": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "type": "string",
      "pattern": "^assets/nc/nc(0[1-9]|1[0-2])-tour\\.webp$"
     }
    ]
   },
   "src": {
    "$ref": "src.schema.json#/$defs/refs"
   },
   "statut": {
    "$ref": "src.schema.json#/$defs/statut"
   }
  }
 }
}
