<tr><td>Biopsie ganglionnaire</td><td>Histologie, immunohistochimie, cytométrie, biologie moléculaire</td><td>Diagnostic de l’entité</td></tr>
<tr><td>Lugano (2014)</td><td>Ann Arbor modifiée, PET-CT, échelle à 5 points</td><td>Stade et réponse</td></tr>
<tr><td>R-IPI (2007)</td><td>Trois groupes pronostiques</td><td>Pronostic sous R-CHOP</td></tr>
<tr><td>NCCN-IPI (2014)</td><td>Cinq facteurs, 8 points, quatre groupes</td><td>Pronostic du DLBCL</td></tr>
<tr><td>OMS 2022 / ICC 2022</td><td>Entités hiérarchisées</td><td>Nom exact du diagnostic</td></tr>
</tbody></table></div>
