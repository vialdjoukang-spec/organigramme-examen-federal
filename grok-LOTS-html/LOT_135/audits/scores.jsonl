{"horodatage": "2026-10-31T11:28:00+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "Phase_A", "fichier": "LOT_135_Phase_A_V0.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 78, "score_langue": 88, "score_pec": 76, "score_examen": 82}, "apres": {"score_medical": 93, "score_langue": 88, "score_pec": 92, "score_examen": 92}, "octets": 156374, "sha256": "3f0cf065aa9d3be9afcc8fcf420022c0630b57d0e650bc43ab2fd2e3f6215af2", "octets_avant": 153769, "question_finale": {"avant": "non", "apres": "oui"}, "corrections": 6, "gravites": {"critique": 0, "grave": 3, "moyen": 3, "léger": 0}, "note": "14/1000 retenu (RMS FR + Thorax 2013) ; 500 ml = clampage pas diagnostic ; ERC/ATLS site aiguille ; matité hépatique non discriminante ; K>5 AIPS ; PNN 250. Liste gelée sans renommer. Rangs DX.3–10 toujours À vérifier."}
{"horodatage": "2026-10-31T11:24:07+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.1", "fichier": "LOT_135_Phase_B_V0_DX.1.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 88, "score_langue": 90, "score_pec": 80, "score_examen": 86}, "apres": {"score_medical": 95, "score_langue": 90, "score_pec": 92, "score_examen": 94}, "octets": 80394, "sha256": "e65e168c37bb7b472eadb85f0a2d0bec187db46c0f00e20c623a4ebc131c503c", "octets_avant": 78349, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 2, "gravites": {"critique": 0, "grave": 0, "moyen": 2, "léger": 0}, "note": "GOLD VEMS/CVF post-BD <0,7 vs dépistage Ligue ; Augmentin 45674 si antibiotique d'exacerbation. Pas de dose inhalée inventée. 90 % tabac reste À vérifier."}
{"horodatage": "2026-10-31T11:24:54+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.2", "fichier": "LOT_135_Phase_B_V0_DX.2.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 82, "score_langue": 90, "score_pec": 92, "score_examen": 86}, "apres": {"score_medical": 94, "score_langue": 90, "score_pec": 92, "score_examen": 92}, "octets": 83915, "sha256": "5964359687693eee66314074af7eeda2f067d7512b111ecfcf8c33a63b5ecb69", "octets_avant": 83068, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 1, "gravites": {"critique": 0, "grave": 1, "moyen": 0, "léger": 0}, "note": "14/1000 après 65 ans retenu (RMS FR + Thorax 2013). Doses Augmentin 45674 déjà exactes. CRB-65 reste À vérifier."}
{"horodatage": "2026-10-31T11:26:02+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.3", "fichier": "LOT_135_Phase_B_V0_DX.3.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 88, "score_langue": 90, "score_pec": 84, "score_examen": 90}, "apres": {"score_medical": 94, "score_langue": 90, "score_pec": 93, "score_examen": 92}, "octets": 82633, "sha256": "6b70d2b1edf3ad30eb1598d6e330d86ef50277fb52c0baba347ef33a2c420768", "octets_avant": 82027, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 2, "gravites": {"critique": 0, "grave": 0, "moyen": 1, "léger": 1}, "note": "Lasix 1500 : plafond deux voies, IV élevé si rein très bas. Volumes BTS 25–50 / 5–10 / 2–5 vérifiés. Rang DX.3 À vérifier."}
{"horodatage": "2026-10-31T11:26:30+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.4", "fichier": "LOT_135_Phase_B_V0_DX.4.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 90, "score_langue": 90, "score_pec": 86, "score_examen": 92}, "apres": {"score_medical": 95, "score_langue": 90, "score_pec": 94, "score_examen": 93}, "octets": 83045, "sha256": "dc61c467ea7e786c050c9d4deda57236579540790767c215c01955a1922342aa", "octets_avant": 82808, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 1, "gravites": {"critique": 0, "grave": 0, "moyen": 1, "léger": 0}, "note": "K>5 et créatinine >4 mg/dl AIPS 27257. PNN 250 et ponction grade 2/3 déjà exacts. Rang DX.4 À vérifier."}
{"horodatage": "2026-10-31T11:27:06+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.5", "fichier": "LOT_135_Phase_B_V0_DX.5.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 84, "score_langue": 90, "score_pec": 88, "score_examen": 86}, "apres": {"score_medical": 94, "score_langue": 90, "score_pec": 90, "score_examen": 93}, "octets": 83027, "sha256": "bff891fa5099d8e44914cb3134e297d4452a9263b59af76b4501c6c4c7293374", "octets_avant": 81853, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 1, "gravites": {"critique": 0, "grave": 1, "moyen": 0, "léger": 0}, "note": "500 ml = clampage LiSA, pas diagnostic. EAU sans volume. Rang DX.5 À vérifier."}
{"horodatage": "2026-10-31T11:27:51+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.6", "fichier": "LOT_135_Phase_B_V0_DX.6.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 90, "score_langue": 90, "score_pec": 86, "score_examen": 90}, "apres": {"score_medical": 95, "score_langue": 90, "score_pec": 94, "score_examen": 93}, "octets": 82344, "sha256": "45943ad5eb9f509a3de581f376f031a96923e82200c3091c1ffe5b3823be5a58", "octets_avant": 81996, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 1, "gravites": {"critique": 0, "grave": 0, "moyen": 1, "léger": 0}, "note": "48 %, CRP>75, 70 %, 90 % déjà exacts. Anse fermée/liquide libre remontés. Rang DX.6 À vérifier."}
{"horodatage": "2026-10-31T11:28:11+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.7", "fichier": "LOT_135_Phase_B_V0_DX.7.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 94, "score_langue": 90, "score_pec": 92, "score_examen": 93}, "apres": {"score_medical": 96, "score_langue": 90, "score_pec": 92, "score_examen": 95}, "octets": 80483, "sha256": "158dbcaf5a7f369b63601a8b131ff2fe5317cd0c21c7278f7552e6e1d35df3a9", "octets_avant": 80483, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 0, "gravites": {"critique": 0, "grave": 0, "moyen": 0, "léger": 0}, "note": "RV Traube 2,5 / Castell 1,2 / palpation 8,2 conformes RMS 2016. Pas de dose. Rang DX.7 À vérifier. Aucune correction."}
{"horodatage": "2026-10-31T11:28:30+01:00", "lot": "LOT_135", "code_ssp": "F1.6", "lecon": "DX.8", "fichier": "LOT_135_Phase_B_V0_DX.8.html", "auditeur": {"agent": "auditeur-medical", "modele": "grok-4.6", "effort": "xhigh"}, "avant": {"score_medical": 93, "score_langue": 90, "score_pec": 92, "score_examen": 90}, "apres": {"score_medical": 95, "score_langue": 90, "score_pec": 92, "score_examen": 93}, "octets": 80460, "sha256": "d0dfb7d744c5900947739473b6d35a58de1ff19239d1a96645e6298c720edf9b", "octets_avant": 80460, "question_finale": {"avant": "oui", "apres": "oui"}, "corrections": 0, "gravites": {"critique": 0, "grave": 0, "moyen": 0, "léger": 0}, "note": "Pas de dose inventée. Matité fixe vs déclive correcte. Attraction médiastinale classique, RV À vérifier. Rang DX.8 À vérifier. Aucune correction."}
