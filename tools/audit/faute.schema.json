{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "faute.schema.json",
 "title": "Faute corrigée par un automate d’audit régional (une ligne de qa/audit/fautes.jsonl)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "unite",
  "region",
  "champ",
  "faute",
  "correction",
  "source",
  "lu_le",
  "gravite",
  "commit",
  "date"
 ],
 "properties": {
  "unite": {
   "type": "string",
   "minLength": 1,
   "description": "Unité auditée : nc07, neuro-nc, glo-lot-03…"
  },
  "element": {
   "type": "string",
   "description": "Élément corrigé, par exemple hyp|bell."
  },
  "region": {
   "enum": [
    "neuro",
    "tetecou",
    "coeurthorax",
    "abdopelvis",
    "locomoteur",
    "peaupopulations"
   ]
  },
  "champ": {
   "type": "string",
   "minLength": 1
  },
  "faute": {
   "type": "string",
   "minLength": 5
  },
  "correction": {
   "type": "string",
   "minLength": 5
  },
  "source": {
   "type": "string",
   "minLength": 2,
   "description": "Source relue (identifiant de src.json et lieu) ou « À vérifier »."
  },
  "lu_le": {
   "type": "string",
   "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
  },
  "gravite": {
   "enum": [
    "critique",
    "majeure",
    "mineure"
   ]
  },
  "commit": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$|^en-attente$"
  },
  "date": {
   "type": "string",
   "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
  },
  "accord_vial": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$",
   "description": "Date de l’accord de Vial ; obligatoire avant fusion pour une faute critique (décision du 17.10.2026)."
  }
 }
}